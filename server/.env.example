# Copy to server/.env, which is ignored by Git. Never put provider keys in extension build variables.
TYPESAFE_API_KEY=replace-with-server-side-typesafe-key
# Generate one separate random token per user; comma-separate multiple tokens.
FORMPILOT_BROKER_TOKENS=replace-with-individual-broker-access-token
FORMPILOT_EXTENSION_ORIGINS=chrome-extension://replace-with-your-extension-id
PORT=8787
